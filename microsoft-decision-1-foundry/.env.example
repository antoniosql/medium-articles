# Written automatically by infra/scripts/deploy.sh or deploy.ps1.
# Copy to .env and fill in by hand if you deployed from the Foundry portal.

# Foundry resource endpoint, as shown on the deployment details page.
# Example: https://<resource-name>.services.ai.azure.com
AZURE_ENDPOINT=

# The deployment name, not the model name.
DEPLOYMENT_NAME=frasohome-decision

# Optional. Leave empty to use Microsoft Entra ID (az login / DefaultAzureCredential).
AZURE_API_KEY=
